{
  "name": "marketplaceonly",
  "description": "Make Facebook show only Marketplace (and Messenger). Not affiliated with Meta.",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev:chrome": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build && wxt build -b firefox --mv3",
    "zip": "wxt zip && wxt zip -b firefox --mv3",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "wxt prepare && tsc --noEmit",
    "lint": "eslint .",
    "postinstall": "wxt prepare",
    "test:e2e": "wxt build && playwright test",
    "build:chrome": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4",
    "wxt": "^0.21.4"
  },
  "license": "MIT"
}
