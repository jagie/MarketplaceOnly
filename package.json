{
  "name": "marketplaceonly",
  "description": "Make Facebook show only Marketplace (and Messenger). Not affiliated with Meta.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:chrome": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build && wxt build -b firefox --mv3",
    "zip": "wxt zip && wxt zip -b firefox --mv3",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "wxt prepare && tsc --noEmit",
    "lint": "eslint .",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4",
    "wxt": "^0.21.4"
  }
}
